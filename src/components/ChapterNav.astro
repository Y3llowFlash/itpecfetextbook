---
import {contents,mainContents,contentsUrl} from '../lib/toc';
interface Props {active?:'reader'|'chapter'|'practice'|'progress';readingPath?:string}
const {active='reader',readingPath}=Astro.props;
const current=readingPath||Astro.url.pathname;
const children=(number:string,depth:number)=>contents.filter(n=>n.depth===depth&&n.number.startsWith(number+'-'));
---
<nav class="chapter-nav" aria-label="Contents">
  <p class="nav-volume">IT FUNDAMENTALS</p>
  <a class="chapter-title" href="/chapters/hardware/"><span class="chapter-icon" aria-hidden="true">1</span><span>Hardware</span></a>
  <ol class="toc-sections">
    {mainContents.map(section=><li>
      <details data-toc-group={section.id} open={current===section.path}>
        <summary><a data-toc-link={section.id} data-toc-section={section.sectionId} href={contentsUrl(section)} aria-current={current===section.path?'page':undefined}><span class="toc-number">{section.number}</span><span>{section.title}<small class="toc-page">p. {section.page}</small></span></a><span class="toc-chevron" aria-hidden="true">⌄</span></summary>
        <ol>{children(section.number,2).map(subsection=><li>
          {children(subsection.number,3).length?<details data-toc-group={subsection.id}>
            <summary><a data-toc-link={subsection.id} data-toc-section={section.sectionId} href={contentsUrl(subsection)}><span class="toc-number">{subsection.number}</span><span>{subsection.title}<small class="toc-page">p. {subsection.page}</small></span></a><span class="toc-chevron" aria-hidden="true">⌄</span></summary>
            <ol>{children(subsection.number,3).map(child=><li><a data-toc-link={child.id} data-toc-section={section.sectionId} href={contentsUrl(child)}><span class="toc-number">{child.number}</span><span>{child.title}<small class="toc-page">p. {child.page}</small></span></a></li>)}</ol>
          </details>:<a data-toc-link={subsection.id} data-toc-section={section.sectionId} href={contentsUrl(subsection)}><span class="toc-number">{subsection.number}</span><span>{subsection.title}<small class="toc-page">p. {subsection.page}</small></span></a>}
        </li>)}</ol>
      </details>
    </li>)}
  </ol>
  <div class="nav-divider"></div>
  <a class="nav-secondary" aria-current={active==='practice'?'page':undefined} href="/practice/">Practice</a>
  <a class="nav-secondary" aria-current={active==='progress'?'page':undefined} href="/progress/">Progress</a>
</nav>
