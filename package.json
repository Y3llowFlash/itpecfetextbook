{
  "name": "itpec-fe-textbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "tsx scripts/validate-data.ts && node scripts/astro.mjs build && tsx scripts/verify-build.ts",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "node scripts/run-rules-tests.mjs",
    "test:accounts": "node scripts/test-accounts.mjs",
    "import:questions": "tsx scripts/import-questions.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "editorial:convert": "python scripts/editorial_convert.py convert",
    "editorial:validate": "python scripts/editorial_convert.py validate",
    "editorial:preview": "node scripts/editorial-server.mjs",
    "editorial:release": "python scripts/publish-source.py",
    "test:editorial": "node scripts/test-editorial.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "astro": "7.4.1",
    "firebase": "13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@firebase/rules-unit-testing": "6.0.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
