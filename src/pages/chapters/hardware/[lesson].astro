---
import HardwareReader from '../../../components/HardwareReader.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import {hardwareLessons} from '../../../lib/lessons';
import {CPU_PATH,CACHE_HEADING} from '../../../lib/reading-routes';
export function getStaticPaths(){return hardwareLessons.map(lesson=>({params:{lesson:lesson.slug},props:{lesson}}));}
const {lesson}=Astro.props;
const legacy=lesson.slug==='memory-and-cache';
---
{legacy?<SiteLayout title="Memory access" description="Memory access in Chapter 1: Hardware." companion={false} noindex>
 <section class="legacy-reading" data-legacy-reader><h1>Memory access</h1><a href={`${CPU_PATH}#${CACHE_HEADING}`}>Continue to 3-5-1 High Speed Memory Access</a></section>
</SiteLayout>:<HardwareReader slug={lesson.slug}/>}
<script>
 import {CPU_PATH,CACHE_HEADING} from '../../../lib/reading-routes';
 if(document.querySelector('[data-legacy-reader]')){
   const target=new URL(CPU_PATH,location.origin);target.search=location.search;
   const fragment=decodeURIComponent(location.hash.slice(1));
   target.hash=/^fev1-201504-ch1-r1-pdf-0(?:75|76|77|78|79)-/.test(fragment)||fragment==='concept-cache-memory'?fragment:CACHE_HEADING;
   location.replace(target.href);
 }
</script>
