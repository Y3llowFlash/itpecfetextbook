---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/ibm-plex-sans';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/reader-refinements.css';
import ChapterNav from '../components/ChapterNav.astro';
import StudyCompanion from '../components/StudyCompanion';
import AccountControls from '../components/AccountControls';
import type { PracticeLink } from '../components/SectionActions';
import { publishedQuestions } from '../lib/catalog';
import {studyContextForConcept} from '../lib/study-context';
import type {StudyContext} from '../lib/toc';
interface Props { title: string; description: string; active?: 'reader' | 'chapter' | 'practice' | 'progress'; noindex?: boolean; companion?: boolean; count?: number; practiceLinks?: PracticeLink[];studyContexts?:StudyContext[];readingPath?:string }
const { title, description, active = 'reader', noindex = false, companion, practiceLinks,studyContexts,readingPath } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const practiceContext=!studyContexts&&practiceLinks?.length?studyContextForConcept(practiceLinks[0].id,await publishedQuestions()):undefined;
const contexts=studyContexts||(practiceContext?[practiceContext]:[]);
const showCompanion=companion!==false&&contexts.length>0;
---
<!doctype html>
<html lang="en" data-reader-page={readingPath?true:undefined}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · ITPEC FE Textbook</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={`${title} · ITPEC FE Textbook`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="ITPEC FE Textbook home"><span class="brand-mark" aria-hidden="true">fe<span>.</span></span><span>ITPEC FE <strong>Textbook</strong></span></a>
      <AccountControls compact client:load />
    </header>
    <div class="mobile-navigation"><details data-mobile-contents><summary>Contents <span aria-hidden="true">⌄</span></summary><ChapterNav active={active} readingPath={readingPath}/></details></div>
    <div class:list={['app-layout', { 'without-companion': !showCompanion }]}>
      <aside class="sidebar"><ChapterNav active={active} readingPath={readingPath}/></aside>
      {showCompanion && <aside class="study-companion" aria-label="Study tools"><details class="study-tools" data-study-tools open><summary>Study tools</summary><StudyCompanion client:load contexts={contexts} initialId={contexts[0].id}/></details></aside>}
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <footer class="site-footer"><span>ITPEC FE Textbook</span><a href="/progress/#about-progress">Progress and account backup</a></footer>
    <script>
      import { getFirebaseAnalytics } from '../lib/firebase';
      void getFirebaseAnalytics();
      import {setupReaderNavigation} from '../lib/reader-navigation';
      setupReaderNavigation();
    </script>
  </body>
</html>
