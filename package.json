{
  "name": "itpec-fe-textbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/generate-reader-toc.mjs --check && tsx scripts/validate-data.ts && node scripts/astro.mjs build && tsx scripts/verify-build.ts",
    "generate:reader-toc": "node scripts/generate-reader-toc.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "node scripts/run-rules-tests.mjs",
    "test:accounts": "node scripts/test-accounts.mjs",
    "import:questions": "tsx scripts/import-questions.ts",
    "questions:sync": "tsx scripts/sync-questions.ts",
    "questions:historical": "python scripts/historical_questions.py",
    "questions:review": "node scripts/question-review-server.mjs",
    "questions:publish": "tsx scripts/publish-historical-questions.ts",
    "questions:reconcile": "tsx scripts/reconcile-historical-questions.ts",
    "questions:qa": "python scripts/academic_qa.py",
    "questions:audit": "python scripts/catalog_audit.py",
    "questions:pilot:prepare": "python scripts/private_student_preview.py prepare",
    "questions:pilot:check": "python scripts/private_student_preview.py check",
    "questions:pilot": "node scripts/private-student-preview-server.mjs",
    "test:pilot": "playwright test --config=playwright.pilot.config.ts",
    "test:pilot-selection": "python -m unittest discover -s tests -p test_private_student_preview.py",
    "test:catalog-audit": "python -m unittest discover -s tests -p test_catalog_audit.py",
    "test:academic": "python -m unittest discover -s tests -p test_academic_qa.py",
    "test:academic-batch2": "python -m unittest discover -s tests -p test_academic_qa_batch2.py",
    "test:academic-batch3": "python -m unittest discover -s tests -p test_academic_qa_batch3.py",
    "test:academic-batch4": "python -m unittest discover -s tests -p test_academic_qa_batch4.py",
    "test:academic-batch5": "python -m unittest discover -s tests -p test_academic_qa_batch5.py",
    "test:owner-adjudication": "python -m unittest discover -s tests -p test_owner_adjudication.py",
    "test:historical": "python -m unittest discover -s tests -p test_historical_questions.py",
    "test:question-promotion": "python -m unittest discover -s tests -p test_question_promotion.py",
    "validate:data": "tsx scripts/validate-data.ts",
    "editorial:convert": "python scripts/editorial_convert.py convert",
    "editorial:validate": "python scripts/editorial_convert.py validate",
    "editorial:preview": "node scripts/editorial-server.mjs",
    "editorial:release": "python scripts/publish-source.py",
    "editorial:spatial": "python scripts/spatial_crops.py",
    "prepare:covers": "python scripts/prepare_book_covers.py",
    "test:editorial": "node scripts/test-editorial.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "astro": "7.4.1",
    "firebase": "13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@firebase/rules-unit-testing": "6.0.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
