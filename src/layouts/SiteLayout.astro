---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/ibm-plex-sans';
import '../styles/tokens.css';
import '../styles/global.css';
import ChapterNav from '../components/ChapterNav.astro';
import StudyCompanion from '../components/StudyCompanion';
import AccountControls from '../components/AccountControls';
interface Props { title: string; description: string; active?: 'reader' | 'chapter' | 'practice' | 'progress'; noindex?: boolean; companion?: boolean; count?: number }
const { title, description, active = 'reader', noindex = false, companion = true, count = 3 } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · ITPEC FE Textbook</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={`${title} · ITPEC FE Textbook`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="ITPEC FE Textbook home"><span class="brand-mark" aria-hidden="true">fe<span>.</span></span><span>ITPEC FE <strong>Textbook</strong></span></a>
      <span class="header-tagline">Understand the idea. Then try it.</span>
      <AccountControls compact client:load />
    </header>
    <div class="mobile-navigation"><details><summary>Chapters & sections <span aria-hidden="true">⌄</span></summary><ChapterNav active={active} /></details></div>
    <div class:list={['app-layout', { 'without-companion': !companion }]}>
      <aside class="sidebar"><ChapterNav active={active} /></aside>
      <main id="main" tabindex="-1"><slot /></main>
      {companion && <aside class="study-companion" aria-label="Study companion"><StudyCompanion client:load questionCount={count} /></aside>}
    </div>
    <footer class="site-footer"><span>ITPEC FE Textbook</span><span>Read. Practise. Understand.</span><a href="/progress/#about-progress">About local progress</a></footer>
    <script>
      import { getFirebaseAnalytics } from '../lib/firebase';
      void getFirebaseAnalytics();
    </script>
  </body>
</html>
