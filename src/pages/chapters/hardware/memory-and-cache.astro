---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { Content, frontmatter } from '../../../content/hardware/memory-and-cache.md';
import SectionActions from '../../../components/SectionActions';
import { concepts, publishedQuestions, questionsForConcept } from '../../../lib/catalog';
const count = questionsForConcept(concepts[0], await publishedQuestions()).length;
---
<SiteLayout title={frontmatter.title} description={frontmatter.description} count={count}>
  <article class="reader" data-reader data-section-id={frontmatter.id}>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/chapters/hardware/">Hardware</a><span aria-hidden="true">/</span><span>CPU & main memory</span></nav>
    <header class="reader-heading"><p class="small-label">CHAPTER 1 · HARDWARE</p><h1>Memory hierarchy<br />& cache</h1><p class="reader-deck">Fast memory is small. Large memory is slower.<br class="desktop-break" /> A hierarchy gives a computer the best of both.</p>
      <div class="lesson-meta"><span>One complete lesson</span><span aria-hidden="true">·</span><a href="/practice/cache-memory/" data-concept="cache-memory" id="practice-from-header">{count} related questions ↗</a></div>
    </header>
    <div class="reader-prose"><Content /></div>
    <div data-reading-block id="lesson-complete"><SectionActions client:load sectionId={frontmatter.id} count={count} /></div>
    <p class="content-note">Original explanations and diagram for this textbook. Chapter structure follows New FE Textbook Vol. 1. Exam images retain their original source attribution.</p>
  </article>
</SiteLayout>
<script>
  import { setupReader } from '../../../lib/reading';
  setupReader();
</script>
