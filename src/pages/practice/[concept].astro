---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Practice from '../../components/Practice';
import { concepts, explanationMap, publishedQuestions, questionsForConcept } from '../../lib/catalog';
export async function getStaticPaths() { return concepts.map((concept) => ({ params: { concept: concept.id }, props: { concept } })); }
const { concept } = Astro.props;
const questions = questionsForConcept(concept, await publishedQuestions());
const explanations = questions.map((question) => explanationMap.get(question.id)!);
---
<SiteLayout title={`${concept.title} practice`} description={concept.summary} active="practice" count={questions.length} practiceLinks={[{ id: concept.id, title: concept.title, count: questions.length }]}>
  <Practice client:load concept={concept} questions={questions} explanations={explanations} />
  <noscript><p class="storage-warning">Answer checking needs JavaScript. You can still <a href={concept.sectionUrl}>read the complete textbook lesson</a>.</p></noscript>
</SiteLayout>
